{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "sent/s по профилям",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(panel_sent_total[1m])", "legendFormat": "{{profile}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 2,
      "title": "флуд-рейт",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "rate(panel_flood_total[1m])", "legendFormat": "flood", "refId": "A"},
        {"expr": "rate(panel_failed_total[1m])", "legendFormat": "failed {{profile}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 3,
      "title": "всего отправлено",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "targets": [{"expr": "sum(panel_sent_total)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "green"}}}
    },
    {
      "id": 4,
      "title": "всего флуд",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "targets": [{"expr": "sum(panel_flood_total)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "red"}}}
    },
    {
      "id": 5,
      "title": "аптайм",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "targets": [{"expr": "panel_uptime_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "title": "rps по профилям",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
      "targets": [{"expr": "panel_rps", "legendFormat": "{{profile}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 7,
      "title": "топ по фейлам (rate 5m)",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "topk(10, rate(panel_failed_total[5m]))", "legendFormat": "{{profile}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 8,
      "title": "тепловая карта по часам",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "sum(rate(panel_sent_total[5m])) by (profile)", "legendFormat": "{{profile}}", "refId": "A"}],
      "options": {"calculate": false, "cellGap": 2, "yAxis": {"unit": "reqps"}}
    },
    {
      "id": 9,
      "title": "эндпоинты: живые vs баненые",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "panel_registry_live_total", "legendFormat": "live", "refId": "A"},
        {"expr": "panel_registry_total - panel_registry_live_total", "legendFormat": "banned", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 10,
      "title": "топ дохнущих эндпоинтов",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{"expr": "topk(10, panel_endpoint_banned)", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}
    },
    {
      "id": 11,
      "title": "страйки по эндпоинтам",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [{"expr": "panel_endpoint_strikes", "legendFormat": "{{name}}", "refId": "A"}],
      "options": {"calculate": false, "cellGap": 2}
    },
    {
      "id": 12,
      "title": "CPU хоста",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 36},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "cpu %", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "custom": {"lineWidth": 2}}}
    },
    {
      "id": 13,
      "title": "RAM хоста",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 36},
      "targets": [{"expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100", "legendFormat": "available %", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "custom": {"lineWidth": 2}}}
    },
    {
      "id": 14,
      "title": "диск хоста",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 36},
      "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\"} * 100", "legendFormat": "free %", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "orange", "value": 10}, {"color": "green", "value": 20}]}}}
    },
    {
      "id": 15,
      "title": "память контейнеров",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 42},
      "targets": [{"expr": "sum by(name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 16,
      "title": "CPU контейнеров",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 42},
      "targets": [{"expr": "sum by(name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 17,
      "title": "рестарты контейнеров",
      "type": "stat",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 48},
      "targets": [{"expr": "sum by(name) (increase(container_start_time_seconds{name!=\"\"}[1h]))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}}
    },
    {
      "id": 18,
      "title": "OOM-события",
      "type": "stat",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 48},
      "targets": [{"expr": "sum by(name) (increase(container_oom_events_total{name!=\"\"}[24h]))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds", "fixedColor": "red"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["panel", "sms"],
  "templating": {
    "list": [
      {"name": "profile", "type": "query", "query": "label_values(panel_sent_total, profile)", "includeAll": true, "multi": true}
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "panel · sms",
  "uid": "panel-sms",
  "version": 1
}
